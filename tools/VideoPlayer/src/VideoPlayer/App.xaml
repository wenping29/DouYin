<Application x:Class="VideoPlayer.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:VideoPlayer.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="src/Themes/Brand.xaml" />
                <ResourceDictionary Source="src/Themes/DarkTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVis" />
            <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis" />
        </ResourceDictionary>
    </Application.Resources>
</Application>