<Window x:Class="VideoPlayer.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置"
        Width="560"
        Height="680"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource WindowBackgroundBrush}"
        FontFamily="Segoe UI"
        FontSize="13"
        Foreground="{StaticResource TextPrimaryBrush}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="0"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border Background="{StaticResource WindowBackgroundBrush}"
            BorderBrush="{StaticResource BorderStrongBrush}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
                <RowDefinition Height="64" />
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Grid Background="{StaticResource TitleBarBrush}"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <TextBlock Text="设置"
                           Margin="20,0,0,0"
                           VerticalAlignment="Center"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}" />
                <Button HorizontalAlignment="Right"
                        Style="{StaticResource CloseCaptionButton}"
                        Content="&#xE8BB;"
                        Click="CloseButton_Click" />
            </Grid>

            <!-- 内容 -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="22,10,22,20">

                    <TextBlock Text="播放" Style="{StaticResource SectionText}" Margin="2,6,0,10" />
                    <Border Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="16">
                        <StackPanel>
                            <CheckBox Style="{StaticResource DarkCheckBox}"
                                      Content="启用硬件加速（DXVA / D3D11）"
                                      IsChecked="{Binding HardwareAcceleration, Mode=TwoWay}" />
                            <TextBlock Text="关闭后改用软件解码，兼容性更好，但 CPU 占用更高。"
                                       Style="{StaticResource CaptionText}"
                                       Margin="28,4,0,12" />

                            <CheckBox Style="{StaticResource DarkCheckBox}"
                                      Content="记住每个文件的播放进度"
                                      IsChecked="{Binding RememberPosition, Mode=TwoWay}" />
                            <CheckBox Style="{StaticResource DarkCheckBox}"
                                      Content="播放结束后自动播放下一个"
                                      IsChecked="{Binding AutoPlayNext, Mode=TwoWay}"
                                      Margin="0,12,0,0" />

                            <Grid Margin="0,18,0,0">
                                <TextBlock Text="默认音量" Style="{StaticResource CaptionText}" />
                                <TextBlock Text="{Binding Volume, StringFormat={}{0}%}"
                                           HorizontalAlignment="Right"
                                           Style="{StaticResource CaptionText}" />
                            </Grid>
                            <Slider Style="{StaticResource SeekSliderStyle}"
                                    Minimum="0"
                                    Maximum="100"
                                    Value="{Binding Volume, Mode=TwoWay}"
                                    Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="字幕" Style="{StaticResource SectionText}" Margin="2,20,0,10" />
                    <Border Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="16">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="字幕缩放（下次播放生效）" Style="{StaticResource CaptionText}" />
                                <TextBlock Text="{Binding SubtitleScale, StringFormat={}{0:0.0}×}"
                                           HorizontalAlignment="Right"
                                           Style="{StaticResource CaptionText}" />
                            </Grid>
                            <Slider Style="{StaticResource SeekSliderStyle}"
                                    Minimum="0.5"
                                    Maximum="2.5"
                                    Value="{Binding SubtitleScale, Mode=TwoWay}"
                                    Margin="0,4,0,16" />

                            <Grid>
                                <TextBlock Text="字幕延迟" Style="{StaticResource CaptionText}" />
                                <TextBlock Text="{Binding SubtitleDelayMs, StringFormat={}{0} ms}"
                                           HorizontalAlignment="Right"
                                           Style="{StaticResource CaptionText}" />
                            </Grid>
                            <Slider Style="{StaticResource SeekSliderStyle}"
                                    Minimum="-5000"
                                    Maximum="5000"
                                    Value="{Binding SubtitleDelayMs, Mode=TwoWay}"
                                    Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="界面" Style="{StaticResource SectionText}" Margin="2,20,0,10" />
                    <Border Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="16">
                        <CheckBox Style="{StaticResource DarkCheckBox}"
                                  Content="显示播放列表面板"
                                  IsChecked="{Binding ShowPlaylist, Mode=TwoWay}" />
                    </Border>

                    <TextBlock Text="文件关联" Style="{StaticResource SectionText}" Margin="2,20,0,10" />
                    <Border Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="16">
                        <StackPanel>
                            <TextBlock x:Name="AssociationStatus"
                                       Text="当前状态：未注册"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       FontSize="12.5" />
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Button Style="{StaticResource AccentButton}"
                                        Content="注册为打开方式"
                                        Click="RegisterAssociation_Click" />
                                <Button Style="{StaticResource TextButton}"
                                        Content="取消注册"
                                        Margin="8,0,0,0"
                                        Click="UnregisterAssociation_Click" />
                                <Button Style="{StaticResource TextButton}"
                                        Content="默认应用设置"
                                        Margin="8,0,0,0"
                                        Click="OpenDefaultApps_Click" />
                            </StackPanel>
                            <TextBlock Text="Windows 10/11 不允许程序静默设置默认应用。注册后请在系统“默认应用”中把 VideoPlayer 设为视频默认程序。"
                                       Style="{StaticResource CaptionText}"
                                       TextWrapping="Wrap"
                                       Margin="0,12,0,0" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="关于" Style="{StaticResource SectionText}" Margin="2,20,0,10" />
                    <Border Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="16">
                        <StackPanel>
                            <TextBlock x:Name="AboutText"
                                       Style="{StaticResource CaptionText}"
                                       LineHeight="20" />
                            <TextBlock Text="仅支持 Windows 10 / 11"
                                       Style="{StaticResource CaptionText}"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       Margin="0,8,0,0" />
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Button Style="{StaticResource TextButton}"
                                        Content="打开日志目录"
                                        Width="120"
                                        Click="OpenLogDirectory_Click" />
                                <TextBlock Text="错误汇总：error.log"
                                           Style="{StaticResource CaptionText}"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           VerticalAlignment="Center"
                                           Margin="12,0,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- 底部按钮 -->
            <Border Grid.Row="2"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,1,0,0">
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,20,0">
                    <Button Style="{StaticResource TextButton}"
                            Content="取消"
                            Width="88"
                            Click="Cancel_Click" />
                    <Button Style="{StaticResource AccentButton}"
                            Content="保存"
                            Width="88"
                            Margin="10,0,0,0"
                            Click="Save_Click" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
