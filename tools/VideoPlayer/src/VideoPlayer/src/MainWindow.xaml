<Window x:Class="VideoPlayer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        xmlns:models="clr-namespace:VideoPlayer.Models"
        mc:Ignorable="d"
        Title="VideoPlayer"
        Width="1280"
        Height="780"
        MinWidth="1024"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{StaticResource WindowBackgroundBrush}"
        FontFamily="Segoe UI"
        FontSize="13"
        Foreground="{StaticResource TextPrimaryBrush}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Icon="pack://application:,,,/Assets/app.ico"
        AllowDrop="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid>
    <Border Background="{StaticResource WindowBackgroundBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="*" />
                <RowDefinition Height="26" />
            </Grid.RowDefinitions>

            <!-- ==================== 标题栏 ==================== -->
            <Grid x:Name="TitleBar"
                  Grid.Row="0"
                  Background="{StaticResource TitleBarBrush}"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal"
                            Margin="14,0,0,0"
                            VerticalAlignment="Center">
                    <Image Source="pack://application:,,,/Assets/app.ico"
                           Width="18"
                           Height="18"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="{Binding WindowTitle}"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="12.5"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="MinimizeButton"
                            Style="{StaticResource CaptionButton}"
                            Content="&#xE921;"
                            ToolTip="最小化"
                            Click="MinimizeButton_Click" />
                    <Button x:Name="MaximizeButton"
                            Style="{StaticResource CaptionButton}"
                            Content="&#xE922;"
                            ToolTip="最大化"
                            Click="MaximizeButton_Click" />
                    <Button Style="{StaticResource CloseCaptionButton}"
                            Content="&#xE8BB;"
                            ToolTip="关闭"
                            Click="CloseButton_Click" />
                </StackPanel>
            </Grid>

            <!-- ==================== 主体 ==================== -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition x:Name="PlaylistColumn" Width="300" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 视频区域 -->
                    <Grid Grid.Row="0" Background="{StaticResource VideoBackgroundBrush}">
                        <vlc:VideoView x:Name="VideoView"
                                       MediaPlayer="{Binding MediaPlayer}"
                                       Background="Black"
                                       Visibility="{Binding HasMedia, Converter={StaticResource BoolToVis}}" />

                        <Border x:Name="EmptyState"
                                Background="{StaticResource WindowBackgroundBrush}"
                                Visibility="{Binding HasMedia, Converter={StaticResource InverseBoolToVis}}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border Width="92"
                                        Height="92"
                                        CornerRadius="24"
                                        HorizontalAlignment="Center"
                                        Background="{StaticResource AccentSoftBrush}">
                                    <TextBlock Text="&#xE786;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="42"
                                               Foreground="{StaticResource AccentBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="拖拽视频文件到这里"
                                           FontSize="20"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           HorizontalAlignment="Center"
                                           Margin="0,22,0,8" />
                                <TextBlock Text="支持 MP4 · MKV · AVI · MOV · FLV · TS · WebM 等 90+ 种格式"
                                           FontSize="12.5"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           HorizontalAlignment="Center" />
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center"
                                            Margin="0,22,0,0">
                                    <Button Style="{StaticResource AccentButton}"
                                            Content="打开文件"
                                            Command="{Binding OpenFilesCommand}" />
                                    <Button Style="{StaticResource TextButton}"
                                            Content="打开文件夹"
                                            Command="{Binding OpenFolderCommand}"
                                            Margin="10,0,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- 控制栏 -->
                    <Border x:Name="ControlBar"
                            Grid.Row="1"
                            Background="{StaticResource ControlBarBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,1,0,0">
                        <Grid Margin="16,9,16,12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- 进度 -->
                            <Grid Grid.Row="0" Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="54" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="54" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="{Binding CurrentTimeText}"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="12"
                                           FontFamily="Consolas" />

                                <Slider x:Name="SeekSlider"
                                        Grid.Column="1"
                                        Style="{StaticResource SeekSliderStyle}"
                                        Minimum="0"
                                        Maximum="1"
                                        Value="{Binding Position, Mode=TwoWay}"
                                        IsEnabled="{Binding HasMedia}" />

                                <TextBlock Grid.Column="2"
                                           Text="{Binding DurationText}"
                                           VerticalAlignment="Center"
                                           TextAlignment="Right"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="12"
                                           FontFamily="Consolas" />
                            </Grid>

                            <!-- 按钮行 -->
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource IconButton}"
                                            Content="&#xE8FD;"
                                            Command="{Binding TogglePlaylistCommand}"
                                            ToolTip="播放列表" />
                                    <Button Style="{StaticResource IconButton}"
                                            Content="&#xE8E5;"
                                            Command="{Binding OpenFilesCommand}"
                                            ToolTip="打开文件" />
                                    <Button Style="{StaticResource IconButton}"
                                            Content="&#xE838;"
                                            Command="{Binding OpenFolderCommand}"
                                            ToolTip="打开文件夹" />
                                </StackPanel>

                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                    <Button Style="{StaticResource IconButton}"
                                            Content="&#xE892;"
                                            Command="{Binding PreviousCommand}"
                                            ToolTip="上一个 / 重新开始" />
                                    <Button Style="{StaticResource PlayButton}"
                                            Command="{Binding PlayPauseCommand}"
                                            Margin="6,0"
                                            ToolTip="播放 / 暂停 (空格)">
                                        <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="20">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="&#xE768;" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                            <Setter Property="Text" Value="&#xE769;" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Button>
                                    <Button Style="{StaticResource IconButton}"
                                            Content="&#xE893;"
                                            Command="{Binding NextCommand}"
                                            ToolTip="下一个" />
                                    <Button Style="{StaticResource IconButton}"
                                            Content="&#xE71A;"
                                            Command="{Binding StopCommand}"
                                            ToolTip="停止" />
                                </StackPanel>

                                <StackPanel Grid.Column="2"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <ComboBox Width="104"
                                              Style="{StaticResource DarkComboBox}"
                                              ItemsSource="{Binding SubtitleTracks}"
                                              SelectedItem="{Binding SelectedSubtitle, Mode=TwoWay}"
                                              DisplayMemberPath="Name"
                                              ToolTip="字幕轨道"
                                              IsEnabled="{Binding HasMedia}" />
                                    <ComboBox Width="100"
                                              Margin="6,0,0,0"
                                              Style="{StaticResource DarkComboBox}"
                                              ItemsSource="{Binding AudioTracks}"
                                              SelectedItem="{Binding SelectedAudio, Mode=TwoWay}"
                                              DisplayMemberPath="Name"
                                              ToolTip="音轨"
                                              IsEnabled="{Binding HasMedia}" />
                                    <ComboBox Width="82"
                                              Margin="6,0,0,0"
                                              Style="{StaticResource DarkComboBox}"
                                              ItemsSource="{Binding AspectRatios}"
                                              SelectedItem="{Binding AspectRatio, Mode=TwoWay}"
                                              ToolTip="画面比例" />
                                    <ComboBox Width="76"
                                              Margin="6,0,0,0"
                                              Style="{StaticResource DarkComboBox}"
                                              ItemsSource="{Binding Rates}"
                                              SelectedItem="{Binding Rate, Mode=TwoWay}"
                                              ItemStringFormat="{}{0:0.##}×"
                                              ToolTip="播放速度" />

                                    <Button Style="{StaticResource IconButton}"
                                            Command="{Binding ToggleMuteCommand}"
                                            Margin="6,0,0,0"
                                            ToolTip="静音 (M)">
                                        <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="16">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="&#xE767;" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsMuted}" Value="True">
                                                            <Setter Property="Text" Value="&#xE74F;" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Button>

                                    <Slider Width="80"
                                            Style="{StaticResource SeekSliderStyle}"
                                            Minimum="0"
                                            Maximum="100"
                                            Value="{Binding Volume, Mode=TwoWay}"
                                            VerticalAlignment="Center"
                                            ToolTip="音量" />

                                    <Button Style="{StaticResource IconButton}"
                                            Content="&#xE722;"
                                            Command="{Binding SnapshotCommand}"
                                            ToolTip="截图 (S)" />

                                    <ToggleButton x:Name="AdjustToggle"
                                                  Style="{StaticResource IconToggleButton}"
                                                  Content="&#xE790;"
                                                  ToolTip="画面调节" />

                                    <Button Style="{StaticResource IconButton}"
                                            Content="&#xE713;"
                                            AutomationProperties.Name="设置"
                                            Command="{Binding OpenSettingsCommand}"
                                            ToolTip="设置" />
                                    <Button Style="{StaticResource IconButton}"
                                            Content="&#xE740;"
                                            Command="{Binding ToggleFullscreenCommand}"
                                            ToolTip="全屏 (F)" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ==================== 播放列表 ==================== -->
                <Border x:Name="PlaylistPanel"
                        Grid.Column="1"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1,0,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Margin="16,14,12,10">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="播放列表" Style="{StaticResource SectionText}" />
                                <Border Background="{StaticResource SurfaceAltBrush}"
                                        CornerRadius="8"
                                        Padding="7,1"
                                        Margin="8,0,0,0">
                                    <TextBlock Text="{Binding Playlist.Count}"
                                               FontSize="11"
                                               Foreground="{StaticResource TextSecondaryBrush}" />
                                </Border>
                            </StackPanel>
                            <Button HorizontalAlignment="Right"
                                    Style="{StaticResource IconButton}"
                                    Width="30"
                                    Height="30"
                                    Content="&#xE74D;"
                                    Command="{Binding ClearPlaylistCommand}"
                                    ToolTip="清空播放列表" />
                        </Grid>

                        <ListBox x:Name="PlaylistList"
                                 Grid.Row="1"
                                 Margin="8,0,8,0"
                                 Style="{StaticResource PlaylistListBox}"
                                 ItemsSource="{Binding Playlist}"
                                 MouseDoubleClick="PlaylistList_MouseDoubleClick">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:MediaItem}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="26" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="{Binding IndexText}"
                                                   VerticalAlignment="Center"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   FontSize="11"
                                                   FontFamily="Consolas" />

                                        <StackPanel Grid.Column="1"
                                                    Margin="2,0,8,0"
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}"
                                                       TextTrimming="CharacterEllipsis"
                                                       FontSize="13"
                                                       Foreground="{StaticResource TextPrimaryBrush}" />
                                            <TextBlock Text="{Binding StatusText}"
                                                       TextTrimming="CharacterEllipsis"
                                                       FontSize="11"
                                                       Foreground="{StaticResource TextMutedBrush}"
                                                       Margin="0,1,0,0" />
                                        </StackPanel>

                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding DurationText}"
                                                   VerticalAlignment="Center"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   FontSize="11"
                                                   FontFamily="Consolas"
                                                   Margin="0,0,6,0" />

                                        <Button Grid.Column="3"
                                                Style="{StaticResource IconButton}"
                                                Width="26"
                                                Height="26"
                                                FontSize="12"
                                                Content="&#xE711;"
                                                Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="移除" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <StackPanel Grid.Row="2" Margin="12,10,12,12">
                            <Button Style="{StaticResource TextButton}"
                                    Content="添加文件"
                                    Command="{Binding OpenFilesCommand}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- ==================== 状态栏 ==================== -->
            <Border x:Name="StatusBar"
                    Grid.Row="2"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,1,0,0">
                <Grid Margin="14,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="6"
                                 Height="6"
                                 Fill="{StaticResource AccentBrush}"
                                 Margin="0,0,8,0" />
                        <TextBlock Text="{Binding StatusText}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="11.5"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <TextBlock HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Text="{Binding MediaInfoText}"
                               Foreground="{StaticResource TextMutedBrush}"
                               FontSize="11.5" />
                </Grid>
            </Border>
        </Grid>
    </Border>

    <!-- ==================== 画面调节弹窗 ==================== -->
    <Popup IsOpen="{Binding IsChecked, ElementName=AdjustToggle}"
           PlacementTarget="{Binding ElementName=AdjustToggle}"
           Placement="Top"
           StaysOpen="False"
           AllowsTransparency="True"
           PopupAnimation="Fade">
        <Border Background="{StaticResource SurfaceAltBrush}"
                BorderBrush="{StaticResource BorderStrongBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="16"
                Width="292"
                Margin="0,0,0,8">
            <StackPanel>
                <Grid Margin="0,0,0,8">
                    <TextBlock Text="画面调节" Style="{StaticResource SectionText}" />
                    <Button Content="重置"
                            HorizontalAlignment="Right"
                            Style="{StaticResource TextButton}"
                            Padding="10,4"
                            Command="{Binding ResetAdjustmentsCommand}" />
                </Grid>

                <Grid Margin="0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="48" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="42" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="亮度" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
                    <Slider Grid.Column="1" Style="{StaticResource SeekSliderStyle}" Minimum="0.5" Maximum="2" Value="{Binding Brightness, Mode=TwoWay}" />
                    <TextBlock Grid.Column="2" Text="{Binding Brightness, StringFormat={}{0:0.00}}" TextAlignment="Right" VerticalAlignment="Center" Style="{StaticResource CaptionText}" />
                </Grid>

                <Grid Margin="0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="48" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="42" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="对比度" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
                    <Slider Grid.Column="1" Style="{StaticResource SeekSliderStyle}" Minimum="0.5" Maximum="2" Value="{Binding Contrast, Mode=TwoWay}" />
                    <TextBlock Grid.Column="2" Text="{Binding Contrast, StringFormat={}{0:0.00}}" TextAlignment="Right" VerticalAlignment="Center" Style="{StaticResource CaptionText}" />
                </Grid>

                <Grid Margin="0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="48" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="42" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="饱和度" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
                    <Slider Grid.Column="1" Style="{StaticResource SeekSliderStyle}" Minimum="0" Maximum="2" Value="{Binding Saturation, Mode=TwoWay}" />
                    <TextBlock Grid.Column="2" Text="{Binding Saturation, StringFormat={}{0:0.00}}" TextAlignment="Right" VerticalAlignment="Center" Style="{StaticResource CaptionText}" />
                </Grid>

                <Grid Margin="0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="48" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="42" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="伽马" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
                    <Slider Grid.Column="1" Style="{StaticResource SeekSliderStyle}" Minimum="0.5" Maximum="2.5" Value="{Binding Gamma, Mode=TwoWay}" />
                    <TextBlock Grid.Column="2" Text="{Binding Gamma, StringFormat={}{0:0.00}}" TextAlignment="Right" VerticalAlignment="Center" Style="{StaticResource CaptionText}" />
                </Grid>

                <Grid Margin="0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="48" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="42" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="色相" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
                    <Slider Grid.Column="1" Style="{StaticResource SeekSliderStyle}" Minimum="-180" Maximum="180" Value="{Binding Hue, Mode=TwoWay}" />
                    <TextBlock Grid.Column="2" Text="{Binding Hue, StringFormat={}{0:0}}" TextAlignment="Right" VerticalAlignment="Center" Style="{StaticResource CaptionText}" />
                </Grid>
            </StackPanel>
        </Border>
    </Popup>
    </Grid>
</Window>
