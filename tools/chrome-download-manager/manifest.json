{
  "manifest_version": 3,
  "name": "Fetch Desk",
  "version": "1.0.0",
  "description": "A lightweight download manager for links you are authorized to download.",
  "permissions": [
    "downloads",
    "contextMenus"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "video-source.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "Fetch Desk",
    "default_popup": "popup.html"
  }
}
