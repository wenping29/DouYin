# 复制为 .env 后按需修改（npm start / npm run dev / npm run seed 会自动加载）
PORT=8080
JWT_SECRET=please-change-this-to-a-long-random-string
NODE_ENV=development

# ---------------- 数据库 ----------------
# sqlite（默认）| postgres
# 不填时：配置了 DATABASE_URL 就自动使用 postgres，否则使用 sqlite
DB_DRIVER=sqlite

# SQLite：单文件数据库，默认 data/douying.db
# DB_PATH=./data/douying.db

# PostgreSQL：方式一，直接给连接串（推荐）
# DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/douying

# PostgreSQL：方式二，分项配置
# PGHOST=127.0.0.1
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=postgres
# PGDATABASE=douying
# PGSSL=false
# PGPOOL_SIZE=10
